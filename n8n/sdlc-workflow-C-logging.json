        240,
        64
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $(\"Extract Event\").item.json.portalBase }}/api/v1/sdlc/requests/{{ $json.id }}/audit",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "=Bearer {{ $(\"Extract Event\").item.json.callbackToken }}"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ action: \"pod.\" + $(\"Extract Event\").item.json.event, metadata: { sessionId: $(\"Extract Event\").item.json.sessionId, ts: $(\"Extract Event\").item.json.ts, data: $(\"Extract Event\").item.json.data } }) }}",
        "options": {
          "timeout": 30000
        }
      },
