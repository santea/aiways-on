            },
            {
              "id": "5",
              "name": "data",
              "type": "object",
              "value": "={{ $json.body.data ?? {} }}"
            },
            {
              "id": "6",
              "name": "portalBase",
              "type": "string",
              "value": "={{ $json.body.portalBaseUrl ?? \"https://portal.bia-dev.domain.net\" }}"
            },
            {
              "id": "7",
              "name": "callbackToken",
              "type": "string",
              "value": "={{ $headers[\"x-callback-token\"] ?? $json.body.callbackToken ?? \"\" }}"
            }
          ]
        },
        "options": {}
      },
      "id": "daff9c74-aa76-4b95-8d7a-78c5f33ade7c",
      "name": "Extract Event",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        16,
        64
      ]
    },
    {
      "parameters": {
        "url": "={{ $(\"Extract Event\").item.json.portalBase }}/api/v1/sdlc/requests?requestNo={{ encodeURIComponent($(\"Extract Event\").item.json.requestNo) }}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "=Bearer {{ $(\"Extract Event\").item.json.callbackToken }}"
            }
          ]
        },
        "options": {
          "response": {
            "response": {
              "neverError": true,
              "responseFormat": "json"
            }
          },
          "timeout": 30000
        }
      },
      "id": "bfca2c2e-638a-45b8-8560-0db69cb0f320",
      "name": "Lookup requestId by requestNo",
